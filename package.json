{
  "name": "nevermin",
  "displayName": "NeverMIN",
  "description": "Never Mind the confusion — I’m gonna use this to speed up understanding. AI onboarding buddy for codebases.",
  "version": "0.0.1",
  "publisher": "abdul-wahid-rukua",
  "author": {
    "name": "Abdul Wahid Rukua"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:nevermin.explorer",
    "onCommand:nevermin.explainSelection",
    "onCommand:nevermin.analyzeRepo",
    "onCommand:nevermin.analyzeSelectedFiles",
    "onCommand:nevermin.selectAllAnalysisFiles",
    "onCommand:nevermin.refreshSidebar",
    "onCommand:nevermin.openSettings",
    "onCommand:nevermin.setApiKey",
    "onCommand:nevermin.openGraphInsight",
    "onCommand:nevermin.openInsightsNarrative",
    "onCommand:nevermin.useGemini",
    "onCommand:nevermin.useDeepSeek"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nevermin.explainSelection",
        "title": "NeverMIN: Jelaskan Kode Ini"
      },
      {
        "command": "nevermin.analyzeRepo",
        "title": "NeverMIN: Analisis Struktur Repo"
      },
      {
        "command": "nevermin.analyzeSelectedFiles",
        "title": "NeverMIN: Pilih File untuk Dianalisis"
      },
      {
        "command": "nevermin.selectAllAnalysisFiles",
        "title": "NeverMIN: Centang Semua File"
      },
      {
        "command": "nevermin.refreshSidebar",
        "title": "NeverMIN: Refresh Sidebar"
      },
      {
        "command": "nevermin.openSettings",
        "title": "NeverMIN: Buka Settings"
      },
      {
        "command": "nevermin.setApiKey",
        "title": "NeverMIN: Simpan API Key"
      },
      {
        "command": "nevermin.openInsightsNarrative",
        "title": "NeverMIN: Buka Ringkasan Insights"
      },
      {
        "command": "nevermin.openGraphInsight",
        "title": "NeverMIN: Buka Insight Graph"
      },
      {
        "command": "nevermin.useGemini",
        "title": "NeverMIN: Pakai Gemini"
      },
      {
        "command": "nevermin.useDeepSeek",
        "title": "NeverMIN: Pakai DeepSeek"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nevermin-sidebar",
          "title": "NeverMIN",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nevermin-sidebar": [
        {
          "id": "nevermin.explorer",
          "name": "Onboarding"
        }
      ]
    },
    "configuration": {
      "title": "NeverMIN",
      "properties": {
        "nevermin.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "deepseek"
          ],
          "default": "gemini",
          "description": "Pilih LLM provider yang dipakai"
        },
        "nevermin.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key fallback untuk provider yang dipilih. Sumber utama disimpan di SecretStorage."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node ./scripts/copy-grammars.js",
    "copy-grammars": "node ./scripts/copy-grammars.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test:compile": "tsc -p ./tsconfig.test.json",
    "test:unit": "npm run test:compile && node ./dist/test/runTest.js",
    "test:e2e": "npm run test:compile && node ./dist/test/e2e/runTest.js",
    "test": "npm run test:unit",
    "package": "npm run copy-grammars && vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^9.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.0"
  }
}
