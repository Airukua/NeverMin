{
  "name": "nevermin",
  "displayName": "NeverMIN",
  "description": "Never Mind the confusion — I’m gonna use this to speed up understanding. AI onboarding buddy for codebases.",
  "version": "0.0.1",
  "publisher": "abdul-wahid-rukua",
  "author": {
    "name": "Abdul Wahid Rukua"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulwahidrukua/NeverMIN"
  },
  "bugs": {
    "url": "https://github.com/abdulwahidrukua/NeverMIN/issues"
  },
  "homepage": "https://github.com/abdulwahidrukua/NeverMIN#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:nevermin.explorer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nevermin.explainSelection",
        "title": "NeverMIN: Jelaskan Kode Ini",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.analyzeRepo",
        "title": "NeverMIN: Analisis Struktur Repo",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.rerunAnalysis",
        "title": "NeverMIN: Hapus & Rerun Analisis",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.clearAnalysisResults",
        "title": "NeverMIN: Hapus Hasil Analisis",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.wipeWorkspaceData",
        "title": "NeverMIN: Wipe Workspace Data",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.analyzeSelectedFiles",
        "title": "NeverMIN: Pilih File untuk Dianalisis",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.selectAllAnalysisFiles",
        "title": "NeverMIN: Centang Semua File",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.clearAnalysisSelection",
        "title": "NeverMIN: Kosongkan Centang File",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.refreshSidebar",
        "title": "NeverMIN: Refresh Sidebar",
        "category": "NeverMIN",
        "icon": "$(refresh)"
      },
      {
        "command": "nevermin.openOutputLogs",
        "title": "NeverMIN: Buka Output Logs",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.clearActivityLogs",
        "title": "NeverMIN: Bersihkan Logs",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.openSettings",
        "title": "NeverMIN: Buka Settings",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.setApiKey",
        "title": "NeverMIN: Simpan API Key",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.openInsightsNarrative",
        "title": "NeverMIN: Buka Ringkasan Insights",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.openGraphInsight",
        "title": "NeverMIN: Buka Insight Graph",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.openMainFlowDiagram",
        "title": "NeverMIN: Buka Tab Flow",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.openLearningMindMap",
        "title": "NeverMIN: Buka Mind Map Belajar",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.openFileFunctionGraph",
        "title": "NeverMIN: Buka Graph Fungsi File",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.analyzeGitHistory",
        "title": "NeverMIN: Analisis Git History",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.rerunGitHistory",
        "title": "NeverMIN: Hapus & Rerun Git History",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.clearGitHistoryResults",
        "title": "NeverMIN: Hapus Hasil Git History",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.openGitHistoryNarrative",
        "title": "NeverMIN: Buka Ringkasan Git History",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.openGitHistoryFile",
        "title": "NeverMIN: Buka File dari Git History",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.selectLanguage",
        "title": "NeverMIN: Pilih Bahasa / Choose Language",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.selectProvider",
        "title": "NeverMIN: Pilih LLM Provider",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.selectOllamaModel",
        "title": "NeverMIN: Pilih Model Ollama",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.choosePrivacyMode",
        "title": "NeverMIN: Choose Private / Public Codebase",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.setPrivacyPrivate",
        "title": "NeverMIN: Use Private Codebase Mode",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.setPrivacyPublic",
        "title": "NeverMIN: Use Public Codebase Mode",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.useGemini",
        "title": "NeverMIN: Pakai Gemini",
        "category": "NeverMIN"
      },
      {
        "command": "nevermin.useDeepSeek",
        "title": "NeverMIN: Pakai DeepSeek",
        "category": "NeverMIN"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nevermin.explainSelection",
          "group": "nevermin@1",
          "when": "editorHasSelection || editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "nevermin.refreshSidebar",
          "when": "view == nevermin.explorer",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nevermin.explorer",
        "contents": "Start by choosing how NeverMIN may analyze this workspace.\n[Private codebase — local / Ollama](command:nevermin.setPrivacyPrivate)\n[Public codebase — cloud LLM OK](command:nevermin.setPrivacyPublic)\n\nThen open a folder and run analysis from the sidebar:\n[Open Folder](command:workbench.action.files.openFolder)\n\nTip: privacy, Structure (folder→file→function), and Git History are in the NeverMIN sidebar — not only in Settings."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nevermin-sidebar",
          "title": "NeverMIN",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nevermin-sidebar": [
        {
          "id": "nevermin.explorer",
          "name": "Onboarding"
        }
      ]
    },
    "configuration": {
      "title": "NeverMIN",
      "properties": {
        "nevermin.language": {
          "order": 1,
          "type": "string",
          "enum": [
            "id",
            "en"
          ],
          "enumDescriptions": [
            "Bahasa Indonesia (UI + jawaban LLM)",
            "English (UI + LLM responses)"
          ],
          "default": "id",
          "markdownDescription": "Bahasa UI sidebar/webview dan bahasa jawaban LLM.\n\nBisa juga diganti dari sidebar **Pengaturan**, atau command `NeverMIN: Pilih Bahasa`."
        },
        "nevermin.provider": {
          "order": 2,
          "type": "string",
          "enum": [
            "ollama",
            "gemini",
            "openai",
            "anthropic",
            "openrouter",
            "deepseek",
            "groq",
            "mistral",
            "together",
            "xai"
          ],
          "enumDescriptions": [
            "Ollama lokal (tanpa API key) — wajib di mode Private",
            "Google Gemini (API key cloud)",
            "OpenAI Chat Completions",
            "Anthropic Claude Messages API",
            "OpenRouter (banyak model, satu key)",
            "DeepSeek Chat Completions",
            "Groq (inference cepat)",
            "Mistral AI",
            "Together AI",
            "xAI Grok"
          ],
          "default": "ollama",
          "markdownDescription": "LLM provider aktif.\n\n**Mode privasi (sidebar, per workspace):**\n- **Private** → provider dikunci ke `ollama`, API key cloud dihapus.\n- **Public** → boleh cloud (Gemini/OpenAI/…). Jika masih Ollama setelah ganti ke Public, pilih provider cloud dulu lalu `NeverMIN: Simpan API Key`.\n\nGanti juga lewat sidebar **Pengaturan** → Provider."
        },
        "nevermin.model": {
          "order": 3,
          "type": "string",
          "default": "",
          "markdownDescription": "Override nama model LLM. Kosongkan = default provider (mis. Ollama `llama3.2`, Gemini `gemini-flash-latest`).\n\nUntuk Ollama, lebih mudah pakai `NeverMIN: Pilih Model Ollama` (deteksi model terpasang / loaded di RAM).\n\n**Penting:** model harus cocok dengan provider aktif. Sisa model Ollama/`gemini-2.5-flash` (sering 404) akan diganti ke default provider."
        },
        "nevermin.temperature": {
          "order": 4,
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "markdownDescription": "Temperature sampling LLM (0 = lebih deterministik). Dipakai Explain Code, narasi insights, dan ringkas node."
        },
        "nevermin.ollamaBaseUrl": {
          "order": 5,
          "type": "string",
          "default": "http://127.0.0.1:11434/v1",
          "markdownDescription": "Base URL OpenAI-compatible untuk **Ollama** (mode Private / provider `ollama`).\n\nDefault lokal: `http://127.0.0.1:11434/v1`. NeverMIN memotong `/v1` saat memanggil API native Ollama (`/api/tags`, `/api/ps`)."
        },
        "nevermin.maxAnalysisFiles": {
          "order": 6,
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 2000,
          "markdownDescription": "Batas maksimum file per run analisis (full-repo atau file tercentang di sidebar **3. Pilih File**).\n\nAnalisis membangun code graph, Structure, insights, dan diagram. Git History memakai `git` lokal terpisah."
        }
      }
    }
  },
  "icon": "media/icon.png",
  "scripts": {
    "postinstall": "node ./scripts/copy-grammars.js",
    "copy-grammars": "node ./scripts/copy-grammars.js",
    "build:webview": "npm run build --prefix webview-ui",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test:compile": "tsc -p ./tsconfig.test.json",
    "test:unit": "npm run test:compile && node -r ./dist/test/mocks/register.js ./dist/test/runTest.js",
    "test:e2e": "npm run test:compile && node ./dist/test/e2e/runTest.js",
    "test": "npm run test:unit",
    "package": "npm run copy-grammars && node ./scripts/ensure-marketplace-icon.js && npm run compile && npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "mermaid": "^10.9.6",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.0"
  }
}
